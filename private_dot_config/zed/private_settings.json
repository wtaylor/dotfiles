// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "ansible": true,
    "csharp": true,
    "dockerfile": true,
    "graphql": true,
    "html": true,
    "nord": true,
    "terraform": true,
    "toml": true
  },
  "which_key": {
    "enabled": true
  },
  "relative_line_numbers": "enabled",
  "disable_ai": true,
  "vim_mode": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Nord Light",
    "dark": "Nord Dark",
  },
}
